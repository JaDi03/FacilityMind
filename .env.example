# ===============================================================
# FacilityMind — Environment Variables Configuration
# Copy this file to .env and fill in your values
# ===============================================================

# MANDATORY: Google Gemini API Key
# Obtain at: https://aistudio.google.com/app/apikey
# Or in Google Cloud Console: https://console.cloud.google.com/apis/credentials
GEMINI_API_KEY=your_api_key_here

# --- Chroma DB Configuration ---
CHROMA_PATH=./data/processed/chroma_db
COLLECTION_NAME=blueprints

# --- Processing Limits ---
MAX_PDF_PAGES=200
MAX_CONTEXT_CHARS=500000

# --- Audio Configuration ---
# Set to true to enable text-to-speech (TTS) output
AUDIO_OUTPUT_ENABLED=false

# --- Visualization Configuration ---
# Set to false to disable image generation for faster processing
VISUALIZATION_ENABLED=true

# --- API Configuration ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO

# ===============================================================
# Circle Web3 & x402 Nanopayments Configuration
# ===============================================================
# Obtain keys and set up at: https://console.circle.com/

# MANDATORY: Circle Web3 Services API Key
CIRCLE_API_KEY=your_circle_api_key_here

# MANDATORY: 32-byte hexadecimal registered Entity Secret (used for RSA-OAEP onchain wallet creation/transfers)
CIRCLE_ENTITY_SECRET=your_32_byte_hex_entity_secret_here

# OPTIONAL: Default container Wallet Set ID (if not provided, a new one will be generated on the fly)
CIRCLE_WALLET_SET_ID=

# MANDATORY: Fallback Source Wallet ID (used for testing or queries where no client wallet is registered)
CIRCLE_SOURCE_WALLET_ID=your_fallback_source_wallet_id_here

# MANDATORY: Blockchain Destination Address (the wallet where you receive SaaS query payments)
CIRCLE_DESTINATION_ADDRESS=0xyour_saas_destination_blockchain_address_here

# MANDATORY: Circle Token ID for USDC on your chosen blockchain (e.g. Fuji testnet USDC token address/identifier)
# Fuji USDC Token Address: 0x5425890298aed601595a70ab815c96711a31bc65
CIRCLE_USDC_TOKEN_ID=0x3600000000000000000000000000000000000000
